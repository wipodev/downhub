{
  "manifest_version": 3,
  "name": "DownHub",
  "version": "1.1.0",
  "description": "Professional video downloader via Native Messaging.",
  "key": "",
  "icons": {
    "16": "ui/icons/icon-16.png",
    "48": "ui/icons/icon-48.png",
    "128": "ui/icons/icon-128.png"
  },
  "permissions": ["scripting", "activeTab", "nativeMessaging"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.kick.com/*",
    "https://kick.com/*",
    "https://www.twitch.tv/*",
    "https://twitch.tv/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*"
  ],
  "background": {
    "service_worker": "background/main.js"
  },
  "action": {
    "default_icon": {
      "128": "ui/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.kick.com/*",
        "https://kick.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "css": ["ui/styles/button.css"],
      "js": ["utils/config.js", "utils/dom.js", "core/downloader.js", "content/siteRegistry.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
